# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=docker
SPRING_APPLICATION_NAME=availability-engine
SERVER_PORT=8080

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/availability_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres123
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Actuator Configuration
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# Swagger/OpenAPI Configuration
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html

# Security Configuration
APP_SECURITY_API_KEY=test-api-key-12345
APP_SECURITY_ENABLED=true

# Health Check Scheduler Configuration
APP_SCHEDULER_ENABLED=true
APP_SCHEDULER_INTERVAL_SECONDS=60
APP_SCHEDULER_TIMEOUT_SECONDS=5
